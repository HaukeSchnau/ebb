{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Ebb",
  "version": "0.5.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "homepage_url": "https://ebb.schnau.dev",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Ebb",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "omnibox": {
    "keyword": "ebb"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "__MSG_openArchive__"
    },
    "clear-window": {
      "description": "__MSG_clearWindow__"
    }
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "favicon",
    "idle",
    "sessions",
    "sidePanel",
    "storage",
    "tabs"
  ]
}
