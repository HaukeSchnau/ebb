{
  "manifest_version": 3,
  "name": "Ebb: Auto-Archive Old Tabs",
  "short_name": "Ebb",
  "version": "0.4.0",
  "description": "Closes tabs you haven't looked at in a while and keeps them in a searchable archive, so you can reopen any of them later.",
  "homepage_url": "https://github.com/HaukeSchnau/ebb",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Ebb",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "omnibox": {
    "keyword": "ebb"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open the archive"
    },
    "clear-window": {
      "description": "Archive every unprotected tab in this window"
    }
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "favicon",
    "idle",
    "sessions",
    "sidePanel",
    "storage",
    "tabs"
  ]
}
